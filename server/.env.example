NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/electrocompare
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional AI provider integration is not enabled by default. The assistant currently uses deterministic catalog matching.

# Optional: only needed when running `npm run create-admin`
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
# ADMIN_NAME=ElectroCompare Admin
